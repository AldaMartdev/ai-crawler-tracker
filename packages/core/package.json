{
  "name": "@ai-crawler-tracker/core",
  "version": "0.1.0",
  "description": "Detect and classify AI crawlers (GPTBot, ClaudeBot, PerplexityBot, ...) from request user agents",
  "license": "Apache-2.0",
  "author": "Bryan Martinez (https://github.com/AldaMartdev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AldaMartdev/ai-crawler-tracker.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AldaMartdev/ai-crawler-tracker#readme",
  "bugs": "https://github.com/AldaMartdev/ai-crawler-tracker/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-crawler",
    "ai-bot",
    "gptbot",
    "claudebot",
    "perplexitybot",
    "bot-analytics",
    "crawler-detection"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
