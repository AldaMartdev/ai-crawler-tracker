{
  "name": "@ai-crawler-tracker/next",
  "version": "0.1.0",
  "description": "Next.js proxy/middleware to track AI crawlers visiting your site",
  "license": "Apache-2.0",
  "author": "Bryan Martinez (https://github.com/AldaMartdev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AldaMartdev/ai-crawler-tracker.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/AldaMartdev/ai-crawler-tracker#readme",
  "bugs": "https://github.com/AldaMartdev/ai-crawler-tracker/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-crawler",
    "gptbot",
    "claudebot",
    "nextjs",
    "middleware",
    "proxy",
    "bot-analytics"
  ],
  "dependencies": {
    "@ai-crawler-tracker/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
