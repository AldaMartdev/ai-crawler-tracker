{
  "name": "@ai-crawler-tracker/dashboard",
  "version": "0.1.0",
  "description": "Local Spanish-language dashboard for AI crawler analytics stored in SQLite",
  "license": "Apache-2.0",
  "author": "Bryan Martinez (https://github.com/AldaMartdev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AldaMartdev/ai-crawler-tracker.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/AldaMartdev/ai-crawler-tracker#readme",
  "bugs": "https://github.com/AldaMartdev/ai-crawler-tracker/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-crawler-dashboard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "node dist/cli.js --demo"
  },
  "keywords": [
    "ai-crawler",
    "dashboard",
    "bot-analytics",
    "self-hosted",
    "sqlite"
  ],
  "dependencies": {
    "@ai-crawler-tracker/core": "workspace:*",
    "@ai-crawler-tracker/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
